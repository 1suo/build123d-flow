{
  "pluginId": "build123d-flow",
  "name": "build123d",
  "version": "0.1.0",
  "description": "Local-first procedural CAD provider using Python AST translation, Pyodide, and OCP.wasm.",
  "declarations": {
    "types": [
      {
        "id": "build123d.shape",
        "class": "item",
        "name": "build123d Shape"
      }
    ],
    "runtimes": [
      {
        "id": "build123d-pyodide",
        "language": "javascript",
        "version": "314.0.7-r18",
        "entry": "/perigram-runtime.js",
        "targets": [
          "browser"
        ]
      }
    ],
    "surfaces": [
      {
        "id": "build123d-cad-preview",
        "module": "/preview/build123d-preview.js",
        "surfaceContract": 1,
        "kind": "preview"
      }
    ],
    "previewChannels": [
      {
        "id": "cad",
        "surface": "build123d-cad-preview",
        "label": "CAD"
      }
    ]
  }
}
